TEXT 256 -1552 Left 2 !.include NE5532.lib\n \n.include IR2104_LTspice_beh.lib\n \n.include irfb7545pbf.spi\n \n.include tlv3501.lib\nB1 OUT_DIFF 0 V=V(OUT_A)-V(OUT_B)\n.tran 0 10m 0 20n startup\n.options method=gear gmin=1e-9 abstol=1e-9 reltol=0.003 trtol=7\n.ic V(VREF2V5)=2.5 V(TRIANGLE)=2.5 V(SCALE_IN)=2.5 V(AUDIO_BIASED)=2.5\n .save V(SCALE_IN) V(VOL_WIPER) V(AUDIO_INV) V(AUDIO_BIASED) V(TRIANGLE) V(SQ) V(PWM_A) V(PWM_B) V(SW_A) V(SW_B) V(OUT_A) V(OUT_B) V(OUT_DIFF) V(HO1) V(LO1) V(HO2) V(LO2) V(u9:hcmd) V(u10:hcmd) I(V6) I(L1) I(L2)\n.four 1k 9 V(OUT_DIFF)\n.meas TRAN I_avg AVG I(V6) FROM 8m TO 10m\n.meas TRAN Pin AVG -24*I(V6) FROM 8m TO 10m\n.meas TRAN Pout AVG V(OUT_DIFF)*V(OUT_DIFF)/4 FROM 8m TO 10m\n.meas TRAN Eff PARAM Pout/Pin
